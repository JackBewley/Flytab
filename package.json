{
  "name": "flytab",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "browser:install": "playwright-core install chromium --no-shell",
    "test:browser": "node tests/browser.mjs && node tests/action-popup.mjs && node tests/popup-ui.mjs",
    "test:ui": "node tests/popup-ui.mjs",
    "test:all": "npm test && npm run test:browser",
    "benchmark": "node tests/startup.mjs",
    "package": "python3 scripts/package.py"
  },
  "devDependencies": {
    "playwright-core": "1.63.0"
  }
}
