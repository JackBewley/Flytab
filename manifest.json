{
  "manifest_version": 3,
  "name": "Flytab",
  "version": "0.6.1",
  "description": "Jump straight back to your previous Chrome tab, across windows.",
  "minimum_chrome_version": "121",
  "incognito": "not_allowed",
  "permissions": [
    "tabs",
    "storage",
    "favicon"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Flytab \u2014 previous tab",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "switch-next": {
      "suggested_key": {
        "default": "Alt+Q",
        "mac": "Alt+F"
      },
      "description": "Switch to previous tab"
    },
    "switch-previous": {
      "suggested_key": {
        "default": "Alt+Shift+Q",
        "mac": "Alt+Shift+F"
      },
      "description": "Open recent tabs"
    }
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
